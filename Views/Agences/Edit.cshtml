@model AkarangaBank.Web.ViewModels.AgenceEditViewModel
@{
    ViewData["Title"] = T["EditAgency"];
}

<h1>@T["EditAgency"]</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger" role="alert"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Nom" class="form-label"></label>
        <input asp-for="Nom" class="form-control" />
        <span asp-validation-for="Nom" class="text-danger" role="alert"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Ville" class="form-label"></label>
        <input asp-for="Ville" class="form-control" />
        <span asp-validation-for="Ville" class="text-danger" role="alert"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="EstSiege" class="form-check-input" />
        <label asp-for="EstSiege" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">@T["Save"]</button>
    <a asp-action="Index" class="btn btn-secondary">@T["Cancel"]</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
