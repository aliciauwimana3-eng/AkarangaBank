@model AkarangaBank.Web.Models.Agence
@{
    ViewData["Title"] = T["Delete"] + " " + T["Agences"] + "?";
}

<h1>@T["Delete"] @T["Agences"]</h1>

<div class="alert alert-warning" role="status" aria-live="polite">
    Confirmez-vous la suppression de cette agence ?
</div>

<dl class="row">
    <dt class="col-sm-3">Code</dt>
    <dd class="col-sm-9">@Model.Code</dd>

    <dt class="col-sm-3">Nom</dt>
    <dd class="col-sm-9">@Model.Nom</dd>

    <dt class="col-sm-3">Ville</dt>
    <dd class="col-sm-9">@Model.Ville</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">@T["Delete"]</button>
    <a asp-action="Index" class="btn btn-secondary">@T["Cancel"]</a>
</form>
