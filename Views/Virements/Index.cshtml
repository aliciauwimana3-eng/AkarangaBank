@model AkarangaBank.Web.ViewModels.VirementListViewModel
@{
    ViewData["Title"] = T["Virements"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@T["Virements"]</h1>
    <a asp-action="Create" class="btn btn-primary">@T["NewTransfer"]</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status" aria-live="polite">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert" aria-live="assertive">@error</div>
}

<div class="table-responsive">
    <table role="table" aria-label="@T["Virements"]" class="table table-striped align-middle">
        <thead><tr><th scope="col">Référence</th><th scope="col">@T["Source"]</th><th scope="col">@T["Recipient"]</th><th scope="col">@T["Amount"]</th><th scope="col">@T["Date"]</th><th scope="col">@T["Status"]</th><th scope="col">@T["Actions"]</th></tr></thead>
        <tbody>
        @foreach (var v in Model.Virements)
        {
            <tr>
                <td>@v.Reference</td>
                <td>@v.CompteSource.NumeroCompte<br /><small>@v.CompteSource.Client.Nom @v.CompteSource.Client.Prenom</small></td>
                <td>
                    @if (v.EstInterbancaire)
                    {
                        <span>@v.BeneficiaireExterne</span><br /><small>@v.BanqueDestination — @v.NumeroCompteExterne</small>
                    }
                    else if (v.CompteDestination is not null)
                    {
                        <span>@v.CompteDestination.NumeroCompte</span><br /><small>@v.CompteDestination.Client.Nom @v.CompteDestination.Client.Prenom</small>
                    }
                </td>
                <td>@v.Montant.ToString("N2") @v.Devise</td>
                <td>@v.DateVirement.ToLocalTime().ToString("g")</td>
                <td><span class="badge @(v.Statut == "Valide" ? "bg-success" : v.Statut == "Rejete" ? "bg-danger" : "bg-warning text-dark")">@(v.Statut == "PretATransmettre" ? "Prêt à transmettre" : v.Statut)</span></td>
                <td>
                    @if (Model.PeutValider && v.Statut == "EnAttente")
                    {
                        <form asp-action="Valider" asp-route-id="@v.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-success" type="submit">@T["Approve"]</button>
                        </form>
                        <form asp-action="Rejeter" asp-route-id="@v.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-danger" type="submit">@T["Reject"]</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Virements.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-muted">Aucun virement enregistré.</td></tr>
        }
        </tbody>
    </table>
</div>
