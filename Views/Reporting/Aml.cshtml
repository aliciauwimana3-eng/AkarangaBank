@model AkarangaBank.Web.ViewModels.AmlMonthlyReport
@{ ViewData["Title"] = "Rapport AML"; Layout = "_LayoutPrint"; }
<div class="container py-4"><div class="d-flex justify-content-between"><h1>Rapport AML — @Model.Month.ToString("MMMM yyyy")</h1><button class="btn btn-outline-secondary no-print" onclick="window.print()">Imprimer</button></div><form method="get" class="d-flex gap-2 mb-3 no-print"><input type="number" name="mois" min="1" max="12" value="@Model.Month.Month" class="form-control" style="max-width:100px"/><input type="number" name="annee" value="@Model.Month.Year" class="form-control" style="max-width:120px"/><button class="btn btn-primary">Afficher</button><a class="btn btn-success" asp-action="ExportAmlExcel" asp-route-annee="@Model.Month.Year" asp-route-mois="@Model.Month.Month">Excel</a></form><div class="row g-3 mb-4"><div class="col">Alertes: <b>@Model.TotalAlerts</b></div><div class="col">Faible: @Model.Low</div><div class="col">Moyen: @Model.Medium</div><div class="col">Élevé: @Model.High</div><div class="col">Critique: @Model.Critical</div><div class="col">DOS/CNRF recensées: @Model.DosCount</div><div class="col">Montant suspect: @Model.SuspiciousAmount.ToString("N2")</div></div><p class="text-muted">Le nombre DOS/CNRF correspond aux alertes ainsi typées dans l’application; aucune transmission externe n’est effectuée par cet état.</p><h2>10 clients les plus signalés</h2><table class="table table-striped"><thead><tr><th>N° client</th><th>Client</th><th>Alertes</th><th>Montant lié</th></tr></thead><tbody>@foreach(var c in Model.TopClients){<tr><td>@c.ClientNumber</td><td>@c.Name</td><td>@c.AlertCount</td><td>@c.SuspiciousAmount.ToString("N2")</td></tr>}</tbody></table></div>
