@model AkarangaBank.Web.ViewModels.UtilisateurResetPasswordViewModel
@{
    ViewData["Title"] = T["ResetPassword"];
}

<h1>@T["ResetPassword"]</h1>
<p class="text-muted">Utilisateur : <strong>@Model.Email</strong></p>

<form asp-action="ResetPassword" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Email" />
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label"></label>
        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="NewPassword" class="text-danger" role="alert"></span>
    </div>

    <button type="submit" class="btn btn-primary">@T["Save"]</button>
    <a asp-action="Index" class="btn btn-secondary">@T["Cancel"]</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
