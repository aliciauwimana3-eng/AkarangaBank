@model AkarangaBank.Web.ViewModels.PretCreateViewModel
@{
    ViewData["Title"] = T["LoanRequest"];
}
<h1>@T["LoanRequest"]</h1>
<p class="text-muted">@T["LoanIntro"]</p>
<div class="row"><div class="col-md-7"><form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3"><label asp-for="TypePretId" class="form-label"></label><select asp-for="TypePretId" asp-items="ViewBag.TypesPret" class="form-select"><option value="0">— Choisir un type —</option></select><span asp-validation-for="TypePretId" class="text-danger" role="alert"></span></div>
    <div class="mb-3"><label asp-for="CompteDebitId" class="form-label"></label><select asp-for="CompteDebitId" asp-items="ViewBag.Comptes" class="form-select"><option value="0">— Choisir —</option></select><span asp-validation-for="CompteDebitId" class="text-danger" role="alert"></span></div>
    <div class="mb-3"><label asp-for="MontantPrincipal" class="form-label"></label><input asp-for="MontantPrincipal" class="form-control" type="number" min="1" step="0.01" /><span asp-validation-for="MontantPrincipal" class="text-danger" role="alert"></span></div>
    <div class="mb-3"><label asp-for="DureeMois" class="form-label"></label><input asp-for="DureeMois" class="form-control" type="number" min="1" max="360" /><span asp-validation-for="DureeMois" class="text-danger" role="alert"></span></div>
    <div class="mb-3"><label asp-for="Commentaire" class="form-label"></label><textarea asp-for="Commentaire" class="form-control" maxlength="500"></textarea><span asp-validation-for="Commentaire" class="text-danger" role="alert"></span></div>
    <button type="submit" class="btn btn-primary">@T["SubmitRequest"]</button> <a asp-action="Index" class="btn btn-secondary">@T["Cancel"]</a>
</form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
