@model AkarangaBank.Web.ViewModels.OperationCreateViewModel
@{
    ViewData["Title"] = T["NewTransaction"];
}

<h1>@T["NewTransaction"]</h1>
<p class="text-muted">@T["OperationIntro"]</p>
<div class="row"><div class="col-md-7">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="mb-3"><label asp-for="CompteId" class="form-label"></label><select asp-for="CompteId" asp-items="ViewBag.Comptes" class="form-select"><option value="0">— @T["Choose"] —</option></select><span asp-validation-for="CompteId" class="text-danger" role="alert"></span></div>
        <div class="mb-3"><label asp-for="TypeOperation" class="form-label"></label><select asp-for="TypeOperation" class="form-select"><option value="Depot">Dépôt</option><option value="Retrait">Retrait</option></select><span asp-validation-for="TypeOperation" class="text-danger" role="alert"></span></div>
        <div class="mb-3"><label asp-for="Montant" class="form-label"></label><input asp-for="Montant" class="form-control" type="number" min="0.01" step="0.01" /><span asp-validation-for="Montant" class="text-danger" role="alert"></span></div>
        <div class="mb-3"><label asp-for="Commentaire" class="form-label"></label><input asp-for="Commentaire" class="form-control" /><span asp-validation-for="Commentaire" class="text-danger" role="alert"></span></div>
        <button type="submit" class="btn btn-primary">@T["SaveTransaction"]</button>
        <a asp-action="Index" class="btn btn-secondary">@T["Cancel"]</a>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
